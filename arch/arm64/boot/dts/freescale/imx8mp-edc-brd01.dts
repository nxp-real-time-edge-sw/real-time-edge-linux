/dts-v1/;

#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/usb/pd.h>
#include "imx8mp.dtsi"
#include "imx8mp-edc-brd01-pinmux.dtsi"        

/ {

  model = "AxisB EDC i.MX8MP Board";
  compatible = "axisb,imx8mp-edc-brd01", "fsl,imx8mp";

  chosen {
    stdout-path = &uart1;
  };

  gpio-leds {
    compatible = "gpio-leds";
    pinctrl-names = "default";
    pinctrl-0 = <&BOARD_InitPins>;

    status {
      label = "yellow:status";
      gpios = <&gpio3 16 GPIO_ACTIVE_HIGH>;
      default-state = "on";
    };
  }

  memory@40000000 {
    device_type = "memory";
    reg = <0x0 0x40000000 0 0xc0000000>,
      <0x1 0x00000000 0 0xc0000000>;
  };

  pcie0_refclk: pcie0-refclk {
    compatible = "fixed-clock";
    #clock-cells = <0>;
    clock-frequency = <100000000>;
  };

  reg_pcie0: regulator-pcie {
    compatible = "regulator-fixed";
    pinctrl-names = "default";
    pinctrl-0 = <&BOARD_InitPins>;
    regulator-name = "MPCIE_3V3";
    regulator-min-microvolt = <3300000>;
    regulator-max-microvolt = <3300000>;
    gpio = <&gpio2 6 GPIO_ACTIVE_HIGH>;
    enable-active-high;
    regulator-always-on;
  };

  reg_usb_vbus: regulator-vbus {
    compatible = "regulator-fixed";
    pinctrl-names = "default";
    pinctrl-0 = <&BOARD_InitPins>;
    regulator-name = "USB_VBUS";
    regulator-min-microvolt = <5000000>;
    regulator-max-microvolt = <5000000>;
    gpio = <&gpio1 14 GPIO_ACTIVE_HIGH>;
    enable-active-high;
    regulator-always-on;
  };

  reg_usdhc2_vmmc: regulator-usdhc2 {
    compatible = "regulator-fixed";
    pinctrl-names = "default";
    pinctrl-0 = <&BOARD_InitPins>;
    regulator-name = "VSD_3V3";
    regulator-min-microvolt = <3300000>;
    regulator-max-microvolt = <3300000>;
    gpio = <&gpio2 19 GPIO_ACTIVE_HIGH>;
    enable-active-high;
  };
};

/* Use the BOARD_InitPins group already defined in the .dtsi */
&iomuxc {
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
};

&dsp {
	status = "okay";
};

&eqos {
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  phy-mode = "rgmii-id";
  phy-handle = <&ethphy0>;
	snps,mtl-tx-config = <&mtl_tx_setup>;
	snps,mtl-rx-config = <&mtl_rx_setup>;
  status = "okay";

  mdio {
    compatible = "snps,dwmac-mdio";
    #address-cells = <1>;
    #size-cells = <0>;

    /* Realtek RTL8211F (0x001cc916) */
    ethphy0: ethernet-phy@1 {
      compatible = "ethernet-phy-ieee802.3-c22";
      reg = <0>;
      max-speed = <1000>;
      // Ask praveen
      eee-broken-1000t;
      realtek,clkout-disable;
    };
  };

  mtl_tx_setup: tx-queues-config {
    snps,tx-queues-to-use = <4>;
    snps,tx-sched-sp;

    queue0 {
      snps,dcb-algorithm;
      snps,priority = <0x1>;
    };

    queue1 {
      snps,dcb-algorithm;
      snps,priority = <0x2>;
    };

    queue2 {
      snps,dcb-algorithm;
      snps,priority = <0x4>;
    };

    queue3 {
      snps,dcb-algorithm;
      snps,priority = <0x8>;
    };

    /* queue4 { */
    /* 	snps,dcb-algorithm; */
    /* 	snps,priority = <0xf0>; */
    /* }; */
  };

  mtl_rx_setup: rx-queues-config {
    snps,rx-queues-to-use = <4>;
    snps,rx-sched-sp;

    queue0 {
      snps,dcb-algorithm;
      snps,priority = <0x1>;
      snps,map-to-dma-channel = <0>;
    };

    queue1 {
      snps,dcb-algorithm;
      snps,priority = <0x2>;
      snps,map-to-dma-channel = <1>;
    };

    queue2 {
      snps,dcb-algorithm;
      snps,priority = <0x4>;
      snps,map-to-dma-channel = <2>;
    };

    queue3 {
      snps,dcb-algorithm;
      snps,priority = <0x8>;
      snps,map-to-dma-channel = <3>;
    };
  };
};

// TODO: Need to add AD2437 dts node
&i2c1 {
  clock-frequency = <400000>;
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  status = "okay";


  pca9548_1: i2c-mux@70 {
    compatible = "nxp,pca9548";
    #address-cells = <1>;
    #size-cells = <0>;
    reg = <0x70>;

    i2c@0 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x0>;

      // Add code for AD2437 U6
    };

    i2c@1 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x1>;

      // Add code for AD2437 U7
    };

    i2c@2 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x2>;

      // Add code for AD2437 U8
    };

    i2c@3 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x3>;

      // Add code for AD2437 U9
    };

    i2c@4 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x4>;

      // Add code for AD2437 U10
    };

    i2c@5 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x5>;

      // Add code for AD2437 U11
    };

    i2c@6 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x6>;

      // Add code for AD2437 U12
    };

    i2c@7 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0x6>;

      // Add code for AD2437 U13
    };
  };
};

&i2c2 {
  clock-frequency = <100000>;
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  status = "okay";

  // Add code for AD2437 U14
};

&i2c3 {
  clock-frequency = <400000>;
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  status = "okay";

  // TODO: Check voltage values
  pmic@25 {
    compatible = "nxp,pca9450c";
    reg = <0x25>;
    pinctrl-names = "default";
    pinctrl-0 = <&BOARD_InitPins>;
    interrupt-parent = <&gpio1>;
    interrupts = <3 IRQ_TYPE_LEVEL_LOW>;

    regulators {
      buck1: BUCK1 {
        regulator-name = "BUCK1";
        regulator-min-microvolt = <805000>;
        regulator-max-microvolt = <1000000>;
        regulator-boot-on;
        regulator-always-on;
        regulator-ramp-delay = <3125>;
      };

      buck2: BUCK2 {
        regulator-name = "BUCK2";
        regulator-min-microvolt = <805000>;
        regulator-max-microvolt = <1050000>;
        regulator-boot-on;
        regulator-always-on;
        regulator-ramp-delay = <3125>;
        nxp,dvs-run-voltage = <1000000>;
        nxp,dvs-standby-voltage = <950000>;
      };

      buck4: BUCK4{
        regulator-name = "BUCK4";
        regulator-min-microvolt = <3000000>;
        regulator-max-microvolt = <3600000>;
        regulator-boot-on;
        regulator-always-on;
      };

      buck5: BUCK5{
        regulator-name = "BUCK5";
        regulator-min-microvolt = <1650000>;
        regulator-max-microvolt = <1950000>;
        regulator-boot-on;
        regulator-always-on;
      };

      buck6: BUCK6 {
        regulator-name = "BUCK6";
        regulator-min-microvolt = <1045000>;
        regulator-max-microvolt = <1155000>;
        regulator-boot-on;
        regulator-always-on;
      };

      ldo1: LDO1 {
        regulator-name = "LDO1";
        regulator-min-microvolt = <1710000>;
        regulator-max-microvolt = <1950000>;
        regulator-boot-on;
        regulator-always-on;
      };

      ldo3: LDO3 {
        regulator-name = "LDO3";
        regulator-min-microvolt = <1710000>;
        regulator-max-microvolt = <1890000>;
        regulator-boot-on;
        regulator-always-on;
      };

      ldo5: LDO5 {
        regulator-name = "LDO5";
        regulator-min-microvolt = <1650000>;
        regulator-max-microvolt = <3600000>;
        regulator-boot-on;
        regulator-always-on;
      };
    };
  };
};

&i2c4{
  clock-frequency = <1000000>;
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  status = "okay";

  ptn5110: tcpc@50 {
    compatible = "nxp,ptn5110";
    reg = <0x50>;

    port {
      usb_con: connector {
        compatible = "usb-c-connector";
        label = "USB-C";
        data-role = "dual";
        power-role = "dual";
        try-power-role = "sink";
        // TODO: Check power settings
        source-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)>;
        sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)
        PDO_VAR(5000, 12000, 2000)>;
        op-sink-microwatt = <10000000>;
      };
    };
  };

  // TODO: Check again before removing
  /* nx20p3483: load-switch@50 { */
  /*   compatible = "nxp,nx20p3483uk"; */
  /*   reg = <0x72>; */
  /* }; */
}

&uart1 {
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  status = "okay";
};

&uart2 {
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  status = "disabled";
};

&uart3 {
  /* Bluetooth */
  pinctrl-names = "default";
  pinctrl-0 = <&BOARD_InitPins>;
  assigned-clocks = <&clk IMX8MP_CLK_UART3>;
  assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
  fsl,uart-has-rtscts;
  status = "okay";
  
  // Quectel Bluetooth driver
};

&usb3_phy0 {
	fsl,phy-tx-vref-tune = <0xe>;
	fsl,phy-tx-preemp-amp-tune = <3>;
	fsl,phy-tx-vboost-level = <5>;
	fsl,phy-comp-dis-tune = <7>;
	fsl,pcs-tx-deemph-3p5db = <0x21>;
	fsl,phy-pcs-tx-swing-full = <0x7f>;
	status = "okay";
};

&usb3_0 {
  status = "okay";
};

&usb_dwc3_0 {
  dr_mode = "otg";
  hnp-disable;
  srp-disable;
  adp-disable;
  usb-role-switch;
  role-switch-default-mode = "none";
  snps,dis-u1-entry-quirk;
  snps,dis-u2-entry-quirk;
  status = "okay";

  port {
    usb3_drd_sw: endpoint {
      remote-endpoint = <&typec_dr_sw>;
    };
  };
};

&usb3_phy1 {
  fsl,phy-tx-preemp-amp-tune = <3>;
  fsl,phy-tx-vref-tune = <0xb>;
  status = "okay";
};

&usb3_1 {
  status = "okay";
};

&usb_dwc3_1 {
  vbus-supply = <&reg_usb_vbus>;
  dr_mode = "host";
  status = "okay";
};

&usdhc2 {
  assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
  assigned-clock-rates = <400000000>;
  pinctrl-names = "default", "state_100mhz", "state_200mhz";
  pinctrl-0 = <&BOARD_InitPins>;
  pinctrl-1 = <&BOARD_InitPins>;
  pinctrl-2 = <&BOARD_InitPins>;
  /* pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>; */
  /* pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>; */
  vmmc-supply = <&reg_usdhc2_vmmc>;
  bus-width = <4>;
  status = "okay";
};

&usdhc3 {
  assigned-clocks = <&clk IMX8MP_CLK_USDHC3>;
  assigned-clock-rates = <400000000>;
  pinctrl-names = "default", "state_100mhz", "state_200mhz";
  pinctrl-0 = <&BOARD_InitPins>;
  pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
  pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
  bus-width = <8>;
  non-removable;
  status = "okay";
};
